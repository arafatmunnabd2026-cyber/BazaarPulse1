# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_CLIENT_ID: Your Google OAuth 2.0 Client ID for backend authentication.
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
# VITE_GOOGLE_CLIENT_ID: Your Google OAuth 2.0 Client ID for frontend.
VITE_GOOGLE_CLIENT_ID="YOUR_VITE_GOOGLE_CLIENT_ID"
# GOOGLE_CLIENT_SECRET: Your Google OAuth 2.0 Client Secret for backend.
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
# GOOGLE_REDIRECT_URI: Your Google OAuth 2.0 Authorized Redirect URI.
GOOGLE_REDIRECT_URI="https://bazaarpulse-1ty4.onrender.com/auth/google/callback"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://mhpmwsafqrjgsodnztll.supabase.co"
VITE_SUPABASE_URL="https://mhpmwsafqrjgsodnztll.supabase.co"
